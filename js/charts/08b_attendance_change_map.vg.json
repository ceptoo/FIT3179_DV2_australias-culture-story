{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Victoria lost the most",
    "subtitle": "Fall in % of adults who attended any cultural venue or event, 2017–18 to 2021–22 (points)"
  },
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "lookup": "properties.state_name",
          "from": {
            "data": {
              "url": "data/attendance_change_by_state.csv"
            },
            "key": "state",
            "fields": [
              "rate_2017_18",
              "rate_2021_22",
              "change_pts"
            ]
          }
        },
        {
          "calculate": "-toNumber(datum.change_pts)",
          "as": "drop"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "drop",
          "type": "quantitative",
          "title": "Drop (percentage points)",
          "scale": {
            "range": [
              "#eef1f5",
              "#9aa9c2",
              "#24324f"
            ],
            "domain": [
              5,
              25
            ],
            "interpolate": "rgb"
          },
          "legend": {
            "gradientLength": 180
          }
        },
        "tooltip": [
          {
            "field": "properties.state_name",
            "title": "State"
          },
          {
            "field": "rate_2017_18",
            "type": "quantitative",
            "title": "2017–18 %",
            "format": ".1f"
          },
          {
            "field": "rate_2021_22",
            "type": "quantitative",
            "title": "2021–22 %",
            "format": ".1f"
          },
          {
            "field": "change_pts",
            "type": "quantitative",
            "title": "Change (pts)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv"
      },
      "transform": [
        {
          "filter": "datum.state_abbr != 'ACT'"
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/attendance_change_by_state.csv"
            },
            "key": "state",
            "fields": [
              "change_pts"
            ]
          }
        },
        {
          "calculate": "datum.state_abbr + ' ' + format(toNumber(datum.change_pts), '+.1f')",
          "as": "label"
        },
        {
          "calculate": "datum.state_abbr == 'VIC' ? -39.3 : datum.lat",
          "as": "lat"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.state_abbr == 'NSW'",
            "value": "white"
          },
          "value": "#2b2622"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 150.6,
            "lat": -36.3
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "color": "#2b2622",
        "fontWeight": 600,
        "dx": 4
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "value": "ACT −20.9"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 16,
      "fontWeight": 600,
      "color": "#2b2622",
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b625a",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#6b625a",
      "titleColor": "#6b625a",
      "domainColor": "#d9d1c3",
      "tickColor": "#d9d1c3",
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#2b2622",
      "titleColor": "#6b625a",
      "orient": "top",
      "direction": "horizontal",
      "columnPadding": 22,
      "labelLimit": 260
    },
    "text": {
      "font": "Source Sans 3",
      "fontSize": 12,
      "color": "#2b2622"
    }
  }
}
