{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The places Australia has chosen to protect",
    "subtitle": "126 National Heritage places by type. Grey shapes = World Heritage areas."
  },
  "width": "container",
  "height": 540,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ece6da",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/world_heritage.topojson",
        "format": {
          "type": "topojson",
          "feature": "world_heritage"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d9d2c3",
        "fillOpacity": 0.7,
        "stroke": "#a3998a",
        "strokeWidth": 0.6
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "title": "World Heritage area"
          },
          {
            "field": "properties.type",
            "title": "Listed for"
          },
          {
            "field": "properties.first_inscribed",
            "title": "Inscribed"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/nhl_places.csv"
      },
      "transform": [
        {
          "filter": "datum.on_main_map == 'true' || datum.on_main_map === true"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 70,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "class",
          "type": "nominal",
          "title": "National Heritage place",
          "scale": {
            "domain": [
              "Indigenous",
              "Natural",
              "Historic"
            ],
            "range": [
              "#b5651d",
              "#3a7d44",
              "#3b4a6b"
            ]
          }
        },
        "opacity": {
          "condition": {
            "test": "type == 'All' || datum.class == type",
            "value": 0.95
          },
          "value": 0.06
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Place"
          },
          {
            "field": "class",
            "title": "Type"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Listed"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 141.88,
            "lat": -38.07,
            "t": "Budj Bim"
          },
          {
            "lon": 130.71,
            "lat": -25.25,
            "t": "Uluru–Kata Tjuta"
          },
          {
            "lon": 132.54,
            "lat": -13.04,
            "t": "Kakadu"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#2b2622",
        "align": "right",
        "dx": -9,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 151.21,
            "lat": -33.86,
            "t": "Sydney Opera House"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#2b2622",
        "align": "left",
        "dx": 9,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 150.2,
            "lat": -39.6,
            "t": "South-east: densest cluster"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#2b2622",
        "fontWeight": 600,
        "align": "left"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 121.5,
            "lat": -27.5,
            "t": "WA"
          },
          {
            "lon": 133.4,
            "lat": -21.5,
            "t": "NT"
          },
          {
            "lon": 135.0,
            "lat": -28.0,
            "t": "SA"
          },
          {
            "lon": 143.0,
            "lat": -26.0,
            "t": "QLD"
          },
          {
            "lon": 145.0,
            "lat": -31.8,
            "t": "NSW"
          },
          {
            "lon": 140.4,
            "lat": -40.3,
            "t": "VIC"
          },
          {
            "lon": 150.8,
            "lat": -42.3,
            "t": "TAS"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "color": "#a89d8c",
        "fontWeight": 700
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 16,
      "fontWeight": 600,
      "color": "#2b2622",
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b625a",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#6b625a",
      "titleColor": "#6b625a",
      "domainColor": "#d9d1c3",
      "tickColor": "#d9d1c3",
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#2b2622",
      "titleColor": "#6b625a",
      "orient": "top",
      "direction": "horizontal",
      "columnPadding": 22,
      "labelLimit": 260
    },
    "text": {
      "font": "Source Sans 3",
      "fontSize": 12,
      "color": "#2b2622"
    }
  },
  "params": [
    {
      "name": "type",
      "value": "All",
      "bind": {
        "input": "radio",
        "options": [
          "All",
          "Indigenous",
          "Natural",
          "Historic"
        ],
        "name": "Show: "
      }
    }
  ]
}
