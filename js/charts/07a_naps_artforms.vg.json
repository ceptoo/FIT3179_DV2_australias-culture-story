{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": {
      "expr": "dom == 'Attended live arts' ? 'Arts attendance has grown since 2022' : dom == 'Created art themselves' ? 'Making art held steady' : 'More Australians attend arts of their own culture'"
    },
    "subtitle": "% of Australians aged 15+, 2022 vs 2025 (labels = change)"
  },
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/naps_2022_vs_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "pct": "number",
        "year": "number"
      }
    }
  },
  "params": [
    {
      "name": "dom",
      "value": "Attended live arts",
      "bind": {
        "input": "select",
        "name": "Show: ",
        "options": [
          "Attended live arts",
          "Created art themselves",
          "Arts of own cultural background"
        ]
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.domain == dom"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "pct",
          "as": "max_pct"
        }
      ],
      "groupby": [
        "measure"
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "measure",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "max_pct",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "labelColor": {
          "condition": {
            "test": "datum.value == 'First Nations arts or festivals'",
            "value": "#b5651d"
          },
          "value": "#6b625a"
        },
        "labelFontWeight": {
          "condition": {
            "test": "datum.value == 'First Nations arts or festivals'",
            "value": 600
          },
          "value": 400
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#d9d1c3",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative"
        },
        "detail": {
          "field": "measure"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative",
          "title": "% of Australians aged 15+",
          "scale": {
            "domain": [
              0,
              80
            ]
          }
        },
        "color": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "scale": {
            "domain": [
              2022,
              2025
            ],
            "range": [
              "#9fd3cf",
              "#0f6e73"
            ]
          }
        },
        "tooltip": [
          {
            "field": "measure",
            "title": "Activity"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "%",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "pivot": "year",
          "value": "pct",
          "groupby": [
            "measure",
            "max_pct"
          ]
        },
        {
          "calculate": "datum['2025'] - datum['2022']",
          "as": "diff"
        },
        {
          "calculate": "(datum.diff >= 0 ? '+' : '−') + format(abs(datum.diff), '.1f')",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "2025",
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        },
        "color": {
          "condition": {
            "test": "datum.measure == 'First Nations arts or festivals'",
            "value": "#b5651d"
          },
          "value": "#0f6e73"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 16,
      "fontWeight": 600,
      "color": "#2b2622",
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b625a",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#6b625a",
      "titleColor": "#6b625a",
      "domainColor": "#d9d1c3",
      "tickColor": "#d9d1c3",
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#2b2622",
      "titleColor": "#6b625a",
      "orient": "top",
      "direction": "horizontal",
      "columnPadding": 22,
      "labelLimit": 260
    },
    "text": {
      "font": "Source Sans 3",
      "fontSize": 12,
      "color": "#2b2622"
    }
  },
  "padding": {
    "left": 24,
    "right": 8,
    "top": 5,
    "bottom": 5
  }
}
