{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Only 139 of 217 languages are",
      "being passed to children"
    ],
    "subtitle": "One square = one language, by who used it at home (2021)"
  },
  "data": {
    "url": "data/indigenous_languages_2021.csv"
  },
  "transform": [
    {
      "calculate": "(datum.rank - 1) % 20",
      "as": "col"
    },
    {
      "calculate": "floor((datum.rank - 1) / 20)",
      "as": "row"
    }
  ],
  "width": "container",
  "height": 253,
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2,
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "status_2021",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Used by children",
          "Used by adults only",
          "No users recorded"
        ],
        "range": [
          "#b5651d",
          "#e3b98f",
          "#e4dccd"
        ]
      },
      "legend": {
        "labelExpr": "datum.label == 'Used by children' ? 'Used by children (139)' : datum.label == 'Used by adults only' ? 'Adults only (28)' : 'No users recorded (50)'",
        "columns": 2
      }
    },
    "tooltip": [
      {
        "field": "language",
        "title": "Language"
      },
      {
        "field": "total_users",
        "type": "quantitative",
        "title": "People using it at home",
        "format": ","
      },
      {
        "field": "children_0_14",
        "type": "quantitative",
        "title": "Of whom children (0–14)",
        "format": ","
      },
      {
        "field": "status_2021",
        "title": "2021 status"
      }
    ]
  },
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 16,
      "fontWeight": 600,
      "color": "#2b2622",
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b625a",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#6b625a",
      "titleColor": "#6b625a",
      "domainColor": "#d9d1c3",
      "tickColor": "#d9d1c3",
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#2b2622",
      "titleColor": "#6b625a",
      "orient": "top",
      "direction": "horizontal",
      "columnPadding": 22,
      "labelLimit": 260
    },
    "text": {
      "font": "Source Sans 3",
      "fontSize": 12,
      "color": "#2b2622"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
