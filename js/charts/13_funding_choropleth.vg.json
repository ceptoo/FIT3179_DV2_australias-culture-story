{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 560,
  "height": 460,
  "data": {
    "url": "data/culture/aus_states.topojson",
    "format": { "type": "topojson", "feature": "states" }
  },
  "transform": [
    {
      "lookup": "properties.state_name",
      "from": {
        "data": { "url": "data/culture/funding_by_state_2023_24.csv" },
        "key": "state",
        "fields": ["state_plus_local_pp"]
      }
    }
  ],
  "projection": { "type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0] },
  "mark": { "type": "geoshape", "stroke": "white" },
  "encoding": {
    "color": {
      "field": "state_plus_local_pp",
      "type": "quantitative",
      "title": "$ per person"
    },
    "tooltip": [
      { "field": "properties.state_name", "title": "State" },
      { "field": "state_plus_local_pp", "type": "quantitative", "title": "$ per person", "format": "$.0f" }
    ]
  }
}