{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Who spends most on culture, per person?",
    "subtitle": "State/territory plus local government cultural spending per resident, 2023–24"
  },
  "width": 600,
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "lookup": "properties.state_name",
          "from": {
            "data": {
              "url": "data/funding_by_state_2023_24.csv"
            },
            "key": "state",
            "fields": [
              "state_plus_local_pp",
              "state_govt_pp",
              "local_govt_pp"
            ]
          }
        },
        {
          "calculate": "datum.local_govt_pp === '' || !isValid(datum.local_govt_pp) ? 'None (no local government in the ACT)' : format(toNumber(datum.local_govt_pp), '$.2f')",
          "as": "local_txt"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "state_plus_local_pp",
          "type": "quantitative",
          "title": "$ per person",
          "scale": {
            "scheme": "goldorange",
            "domain": [
              150,
              330
            ]
          },
          "legend": {
            "format": "$.0f",
            "gradientLength": 220
          }
        },
        "tooltip": [
          {
            "field": "properties.state_name",
            "title": "State"
          },
          {
            "field": "state_plus_local_pp",
            "type": "quantitative",
            "title": "Total per person",
            "format": "$.2f"
          },
          {
            "field": "state_govt_pp",
            "type": "quantitative",
            "title": "State/territory govt",
            "format": "$.2f"
          },
          {
            "field": "local_txt",
            "title": "Local govt"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv"
      },
      "transform": [
        {
          "filter": "datum.state_abbr != 'ACT'"
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/funding_by_state_2023_24.csv"
            },
            "key": "state",
            "fields": [
              "state_plus_local_pp"
            ]
          }
        },
        {
          "calculate": "datum.state_abbr + ' $' + format(datum.state_plus_local_pp, '.0f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#2b2622"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 150.6,
            "lat": -36.3
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "color": "#2b2622",
        "fontWeight": 600,
        "dx": 4
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "value": "ACT $210"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 16,
      "fontWeight": 600,
      "color": "#2b2622",
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b625a",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#6b625a",
      "titleColor": "#6b625a",
      "domainColor": "#d9d1c3",
      "tickColor": "#d9d1c3",
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#2b2622",
      "titleColor": "#6b625a",
      "orient": "top",
      "direction": "horizontal",
      "columnPadding": 22,
      "labelLimit": 260
    },
    "text": {
      "font": "Source Sans 3",
      "fontSize": 12,
      "color": "#2b2622"
    }
  }
}