{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The night the music stopped, and came back louder",
    "subtitle": "Tickets issued for live performances by category, 2010–2024. Band thickness = tickets. Hover a band to pick it out."
  },
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/live_by_category_2010_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "attendance": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.category == 'Contemporary Music' ? 'Contemporary music' : datum.category == 'Musical Theatre' ? 'Musical theatre' : indexof(datum.category, 'Festivals') == 0 ? 'Festivals' : datum.category == 'Comedy' ? 'Comedy' : datum.category == \"Children's/Family\" ? \"Children's and family\" : (datum.category == 'Classical Music' || datum.category == 'Opera') ? 'Classical music and opera' : 'Other'",
      "as": "group"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "attendance",
          "as": "attendance"
        }
      ],
      "groupby": [
        "group",
        "year"
      ]
    },
    {
      "calculate": "datum.attendance / 1e6",
      "as": "tickets_m"
    },
    {
      "calculate": "indexof([\"Contemporary music\", \"Musical theatre\", \"Festivals\", \"Comedy\", \"Children's and family\", \"Classical music and opera\", \"Other\"], datum.group)",
      "as": "ord"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "group"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "axis": {
            "format": "d",
            "tickCount": 8
          }
        },
        "y": {
          "field": "tickets_m",
          "type": "quantitative",
          "stack": "center",
          "title": "Tickets (millions)",
          "axis": {
            "labels": false,
            "grid": false,
            "ticks": false
          }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "title": null,
          "sort": [
            "Contemporary music",
            "Musical theatre",
            "Festivals",
            "Comedy",
            "Children's and family",
            "Classical music and opera",
            "Other"
          ],
          "scale": {
            "domain": [
              "Contemporary music",
              "Musical theatre",
              "Festivals",
              "Comedy",
              "Children's and family",
              "Classical music and opera",
              "Other"
            ],
            "range": [
              "#4a5a78",
              "#7b5c8a",
              "#4f7d5c",
              "#c9a227",
              "#7d97b3",
              "#8c7b6b",
              "#cfc6b8"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "columns": 4,
            "symbolType": "square"
          }
        },
        "order": {
          "field": "ord"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.25
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Category"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "tickets_m",
            "type": "quantitative",
            "title": "Tickets (millions)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2020,
            "y": 31.3,
            "y2": 22.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#2b2622",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2020,
            "y": 34.6,
            "t": "2020: COVID shutdowns,"
          },
          {
            "year": 2020,
            "y": 33.0,
            "t": "tickets down 67%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#2b2622"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2010,
            "y": 24.345558999999998,
            "t": "17.2m tickets",
            "a": "left"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": -9,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#2b2622",
        "align": "left"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2024,
            "y": 31.449979,
            "t": "31.4m tickets",
            "a": "right"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": -9,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#2b2622",
        "align": "right"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 16,
      "fontWeight": 600,
      "color": "#2b2622",
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b625a",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#6b625a",
      "titleColor": "#6b625a",
      "domainColor": "#d9d1c3",
      "tickColor": "#d9d1c3",
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#2b2622",
      "titleColor": "#6b625a",
      "orient": "top",
      "direction": "horizontal",
      "columnPadding": 22,
      "labelLimit": 260
    },
    "text": {
      "font": "Source Sans 3",
      "fontSize": 12,
      "color": "#2b2622"
    }
  }
}
