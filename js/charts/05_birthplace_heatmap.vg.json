{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "From Britain to the world",
    "subtitle": "Share of Australia's population born in each country, 1901–2021 (blank = not recorded separately). Census counts to 1996, population estimates from 2001."
  },
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/birthplace_heatmap_1901_2021.csv"
  },
  "transform": [
    {
      "filter": "datum.pct_of_population !== '' && isValid(datum.pct_of_population)"
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 16,
      "fontWeight": 600,
      "color": "#2b2622",
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b625a",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#6b625a",
      "titleColor": "#6b625a",
      "domainColor": "#d9d1c3",
      "tickColor": "#d9d1c3",
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#2b2622",
      "titleColor": "#6b625a",
      "orient": "top",
      "direction": "horizontal",
      "columnPadding": 22,
      "labelLimit": 260
    },
    "text": {
      "font": "Source Sans 3",
      "fontSize": 12,
      "color": "#2b2622"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": -45,
            "orient": "top"
          }
        },
        "y": {
          "field": "country",
          "type": "nominal",
          "title": null,
          "sort": [
            "UK & Ireland",
            "India",
            "China",
            "New Zealand",
            "Philippines",
            "Vietnam",
            "Italy",
            "Germany",
            "Greece",
            "Netherlands"
          ]
        },
        "color": {
          "field": "pct_of_population",
          "type": "quantitative",
          "title": "% of population",
          "scale": {
            "type": "sqrt",
            "range": [
              "#eef1f5",
              "#9aa9c2",
              "#24324f"
            ],
            "interpolate": "rgb"
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 260
          }
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Born in"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "people",
            "type": "quantitative",
            "title": "People",
            "format": ","
          },
          {
            "field": "pct_of_population",
            "type": "quantitative",
            "title": "% of population",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "(toNumber(datum.year) == 1901 && datum.country == 'UK & Ireland') || (toNumber(datum.year) == 1971 && (datum.country == 'Italy' || datum.country == 'Greece')) || (toNumber(datum.year) == 2021 && (datum.country == 'India' || datum.country == 'China' || datum.country == 'UK & Ireland'))"
        },
        {
          "calculate": "format(datum.pct_of_population, '.1f') + '%'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": [
            "UK & Ireland",
            "India",
            "China",
            "New Zealand",
            "Philippines",
            "Vietnam",
            "Italy",
            "Germany",
            "Greece",
            "Netherlands"
          ]
        },
        "text": {
          "field": "lab"
        },
        "color": {
          "condition": {
            "test": "datum.pct_of_population > 3",
            "value": "white"
          },
          "value": "#2b2622"
        }
      }
    }
  ]
}
