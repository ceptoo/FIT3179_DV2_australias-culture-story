{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": "Where $8.6 billion of culture funding went in 2023–24",
    "subtitle": "Box size = dollars. Colour = level of government; solid = heritage, lighter = arts. Local government is not split.",
    "anchor": "start",
    "fontSize": 16,
    "fontWeight": 600,
    "color": "#2b2622",
    "font": "Source Sans 3",
    "subtitleFontSize": 13,
    "subtitleColor": "#6b625a",
    "subtitleFont": "Source Sans 3",
    "offset": 12
  },
  "width": 480,
  "height": 560,
  "padding": {
    "left": 4,
    "right": 4,
    "top": 4,
    "bottom": 24
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": [
    {
      "name": "cats",
      "url": "data/funding_by_category.csv",
      "format": {
        "type": "csv",
        "parse": "auto"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.year == '2023-24' && datum.amount_m > 0"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "{'Other museums and cultural heritage': 'Other heritage','Film and video production and distribution': 'Film & video','Radio and television services': 'Radio & TV','Community arts and cultural development': 'Community arts','Performing arts venues': 'Performing arts venues','Music theatre and opera': 'Music theatre & opera','Visual arts and crafts': 'Visual arts','Literature and writing': 'Literature & writing','Circus and physical theatre': 'Circus','Interactive arts content': 'Interactive arts','Arts administration': 'Arts admin','Local government (all categories)': 'All local spending'}[datum.category] || datum.category"
        }
      ]
    },
    {
      "name": "local",
      "url": "data/funding_by_level.csv",
      "format": {
        "type": "csv",
        "parse": "auto"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.year == '2023-24' && datum.level == 'Local government'"
        },
        {
          "type": "formula",
          "as": "domain",
          "expr": "'All local'"
        },
        {
          "type": "formula",
          "as": "category",
          "expr": "'All local spending'"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "'All local spending'"
        }
      ]
    },
    {
      "name": "tree",
      "source": [
        "cats",
        "local"
      ],
      "transform": [
        {
          "type": "nest",
          "keys": [
            "level",
            "domain"
          ],
          "generate": true
        },
        {
          "type": "treemap",
          "field": "amount_m",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.4,
          "paddingInner": 1,
          "paddingOuter": 0,
          "paddingTop": 0,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    },
    {
      "name": "levels",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Australian Government",
        "State and territory government",
        "Local government"
      ],
      "range": [
        "#3e6f94",
        "#7a4a7f",
        "#5f7022"
      ]
    },
    {
      "name": "split",
      "type": "ordinal",
      "domain": [
        "Heritage",
        "Arts"
      ],
      "range": [
        1,
        0.55
      ]
    }
  ],
  "legends": [
    {
      "fill": "color",
      "orient": "top",
      "direction": "horizontal",
      "symbolType": "square",
      "labelFont": "Source Sans 3",
      "labelFontSize": 12,
      "labelColor": "#2b2622",
      "labelLimit": 400,
      "columnPadding": 20
    },
    {
      "opacity": "split",
      "orient": "bottom",
      "direction": "horizontal",
      "symbolType": "square",
      "symbolFillColor": "#6b625a",
      "symbolStrokeColor": "#6b625a",
      "labelFont": "Source Sans 3",
      "labelFontSize": 12,
      "labelColor": "#2b2622",
      "columnPadding": 20,
      "labelExpr": "datum.label == 'Heritage' ? 'Heritage (solid)' : 'Arts (lighter)'"
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 1
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "color",
            "field": "level"
          },
          "tooltip": {
            "signal": "{'Level': datum.level, 'Area': datum.domain, 'Category': datum.category, 'Spending': format(datum.amount_m, '$,.1f') + 'm'}"
          },
          "fillOpacity": {
            "signal": "datum.domain == 'Arts' ? 0.55 : 1"
          }
        },
        "hover": {
          "fillOpacity": {
            "signal": "datum.domain == 'Arts' ? 0.4 : 0.8"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "levels"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 4
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 6"
          },
          "y": {
            "signal": "datum.y0 + 16"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) > 60 && (length(datum.label) * 7 > (datum.x1 - datum.x0) - 12 ? length(split(datum.label, ' ')) + 1 : 2) * 15 + 14 < (datum.y1 - datum.y0) ? (length(datum.label) * 7 > (datum.x1 - datum.x0) - 12 ? replace(datum.label, regexp(' (?!&)', 'g'), '|') : datum.label) + '|' + format(datum.amount_m, '$,.0f') + 'm' : ''"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 10"
          },
          "fill": {
            "signal": "datum.domain == 'Arts' ? '#2b2622' : 'white'"
          },
          "font": {
            "value": "Source Sans 3"
          },
          "fontSize": {
            "value": 13
          },
          "lineHeight": {
            "value": 15
          },
          "lineBreak": {
            "value": "|"
          }
        }
      }
    }
  ]
}
