{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Older Australians grew the most",
    "subtitle": "% who attended a live arts event or festival, by age"
  },
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/naps_live_attendance_by_age.csv",
    "format": {
      "type": "csv",
      "parse": {
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.year == 2022 ? '2022' : '2025'",
      "as": "yr"
    },
    {
      "calculate": "datum.age_group == '55-64' || datum.age_group == '65+'",
      "as": "older"
    },
    {
      "calculate": "datum.age_group + '  ' + format(datum.pct, '.0f') + '%'",
      "as": "label"
    }
  ],
  "encoding": {
    "x": {
      "field": "yr",
      "type": "ordinal",
      "title": null,
      "scale": {
        "padding": 0.6
      },
      "axis": {
        "labelAngle": 0,
        "orient": "top",
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "pct",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          40,
          90
        ]
      },
      "axis": {
        "labels": false,
        "ticks": false,
        "domain": false,
        "grid": false
      }
    },
    "detail": {
      "field": "age_group"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "encoding": {
        "color": {
          "field": "older",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              true,
              false
            ],
            "range": [
              "#2b2622",
              "#cfc8bb"
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 60,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "field": "older",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              true,
              false
            ],
            "range": [
              "#2b2622",
              "#cfc8bb"
            ]
          }
        },
        "tooltip": [
          {
            "field": "age_group",
            "title": "Age"
          },
          {
            "field": "yr",
            "title": "Year"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "% attended",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.yr == '2025'"
        },
        {
          "calculate": "datum.pct + (datum.age_group == '15-24' ? -1.3 : datum.age_group == '25-34' ? 1.3 : 0)",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "label"
        },
        "color": {
          "value": "#2b2622"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.yr == '2022'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 12,
        "color": "#6b625a"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 16,
      "fontWeight": 600,
      "color": "#2b2622",
      "anchor": "start",
      "subtitleFontSize": 13,
      "subtitleColor": "#6b625a",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#6b625a",
      "titleColor": "#6b625a",
      "domainColor": "#d9d1c3",
      "tickColor": "#d9d1c3",
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#2b2622",
      "titleColor": "#6b625a",
      "orient": "top",
      "direction": "horizontal",
      "columnPadding": 22,
      "labelLimit": 260
    },
    "text": {
      "font": "Source Sans 3",
      "fontSize": 12,
      "color": "#2b2622"
    }
  }
}
